# Docker build context hygiene: exclude everything heavy, secret or runtime.
# NOTE: models/ is deliberately NOT excluded — the cloud image bakes the ONNX
# serving artifacts (45MB). Exclusion/re-inclusion pattern games proved
# fragile across BuildKit versions; a slightly larger context (~130MB) is
# a far better trade than a broken cloud build.

# VCS / CI / IDE
.git
.github
.gitignore

# Virtual envs (GBs) and caches
.venv
venv
**/node_modules
**/__pycache__
**/.pytest_cache

# Datasets (reproducible via scripts/train.sh; never shipped)
data

# Runtime state & logs
backend/inspection.db
backend/storage
*.log
logs
share_demo_*.log

# Env & secrets
.env
*.env.local

# Frontend: rebuilt inside the image; never ship the local build
frontend/dist
frontend/npm_install.log
frontend/tsconfig.tsbuildinfo
frontend/.env*

# Docs/scratch not needed inside images
docs
deploy/_scratch

# ============================================================
# AI Visual Inspection Platform — environment template
# Copy to .env and adjust. NEVER commit real secrets.
# All vars use the VI_ prefix. Defaults suit local development.
# ============================================================

# --- Application ---
VI_ENVIRONMENT=development

# --- Database ---
# SQLite for local dev. Swap for postgres in production:
#   VI_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/inspections
VI_DATABASE_URL=sqlite:///./backend/inspection.db

# --- Storage (uploaded originals + generated overlays) ---
VI_UPLOAD_DIR=./backend/storage/uploads

# --- Upload limits ---
VI_MAX_UPLOAD_MB=10
VI_MAX_IMAGE_DIM=4096

# --- Model artifacts ---
VI_MODEL_CHECKPOINT=./models/experiments/v1_resnet18/best.pth
VI_MODEL_VERSION=v1.0.0
VI_MODEL_EXPERIMENT=v1_resnet18

# --- Confidence policy (documented in docs/severity.md) ---
VI_CONFIDENCE_HIGH=0.80
VI_CONFIDENCE_MEDIUM=0.60

# --- CORS (comma-separated origins) ---
VI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Single-origin deployments (HF Spaces / single Docker container) ---
# If set to a built frontend dist directory, the API also serves the SPA
# from the same origin (no CORS, no second container). Empty = API-only.
# Example: VI_FRONTEND_DIST=./frontend/dist
VI_FRONTEND_DIST=
